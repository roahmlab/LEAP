<?xml version="1.0"?>
<!--
  hopper2d_foot: hopper2d with a flat foot, generated by
  scripts/urdf/gen_planar_robots.py (do not hand-edit).
    world -> base_px..base_rz -> torso -> hip -> thigh -> knee -> shank
    -> ankle -> sole
  nq = nv = 9, nu = 3 (hip, knee, ankle), total mass 12.40 kg.
  Every joint axis is +y, so the sagittal plane is invariant and the
  problem pins (base_py, base_rx, base_rz) = 0 (`planarlock`).
  Uniform solid cylinders / boxes; the sole is a box hanging from the
  ankle (its top face at the ankle), `foot` is the centre of its bottom
  face (0.05 x 0.05 m sole, 0.012 m thick).
--> 
<robot name="hopper2d_foot">
  <link name="world"/>
  <link name="base_px_link"/>
  <link name="base_py_link"/>
  <link name="base_pz_link"/>
  <link name="base_rx_link"/>
  <link name="base_ry_link"/>

  <joint name="base_px" type="prismatic">
    <parent link="world"/><child link="base_px_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <joint name="base_py" type="prismatic">
    <parent link="base_px_link"/><child link="base_py_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <joint name="base_pz" type="prismatic">
    <parent link="base_py_link"/><child link="base_pz_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <joint name="base_rx" type="revolute">
    <parent link="base_pz_link"/><child link="base_rx_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <joint name="base_ry" type="revolute">
    <parent link="base_rx_link"/><child link="base_ry_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <joint name="base_rz" type="revolute">
    <parent link="base_ry_link"/><child link="torso"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-100" upper="100" effort="1000" velocity="1000"/>
  </joint>
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="0.10346667" ixy="0" ixz="0" iyy="0.096" iyz="0" izz="0.026666667"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry><box size="0.12 0.16 0.36"/></geometry>
    </collision>
  </link>
  <link name="thigh">
    <inertial>
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.022895833" ixy="0" ixz="0" iyy="0.022895833" iyz="0" izz="0.003125"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.32"/></geometry>
    </collision>
  </link>
  <link name="shank">
    <inertial>
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>
      <mass value="1.6"/>
      <inertia ixx="0.014293333" ixy="0" ixz="0" iyy="0.014293333" iyz="0" izz="0.00128"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.32"/></geometry>
    </collision>
  </link>
  <link name="sole">
    <inertial>
      <origin xyz="0 0 -0.006" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="6.61e-05" ixy="0" ixz="0" iyy="6.61e-05" iyz="0" izz="0.000125"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.006" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.012"/></geometry>
    </collision>
  </link>
  <joint name="hip" type="revolute">
    <parent link="torso"/><child link="thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1" effort="120" velocity="20"/>
  </joint>
  <joint name="knee" type="revolute">
    <parent link="thigh"/><child link="shank"/>
    <origin xyz="0 0 -0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2" effort="120" velocity="20"/>
  </joint>
  <joint name="ankle" type="revolute">
    <parent link="shank"/><child link="sole"/>
    <origin xyz="0 0 -0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1" upper="1" effort="40" velocity="20"/>
  </joint>
  <link name="foot"/>
  <joint name="foot_fixed" type="fixed">
    <parent link="sole"/><child link="foot"/>
    <origin xyz="0 0 -0.012" rpy="0 0 0"/>
  </joint>
  <link name="foot_heel"/>
  <joint name="foot_heel_fixed" type="fixed">
    <parent link="sole"/><child link="foot_heel"/>
    <origin xyz="-0.025 0 -0.012" rpy="0 0 0"/>
  </joint>
  <link name="foot_toe"/>
  <joint name="foot_toe_fixed" type="fixed">
    <parent link="sole"/><child link="foot_toe"/>
    <origin xyz="0.025 0 -0.012" rpy="0 0 0"/>
  </joint>
  <link name="knee_point"/>
  <joint name="knee_point_fixed" type="fixed">
    <parent link="shank"/><child link="knee_point"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
